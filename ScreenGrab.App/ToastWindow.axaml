<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="ScreenGrab.App.ToastWindow"
        WindowDecorations="None"
        Background="Transparent"
        TransparencyLevelHint="Transparent"
        Topmost="True"
        ShowInTaskbar="False"
        CanResize="False"
        SizeToContent="WidthAndHeight"
        WindowStartupLocation="CenterScreen">

	<!-- Rounded, semi-opaque slate panel — the Avalonia replacement for the WinForms toast's
	     CreateRoundRectRgn P/Invoke (Form1 L1041). -->
	<Border Background="#E62F4F4F" CornerRadius="15" Padding="20" MinWidth="360" MaxWidth="640">
		<TextBlock x:Name="MessageText"
		           Foreground="White"
		           FontFamily="Segoe UI"
		           FontSize="13"
		           TextAlignment="Center"
		           TextWrapping="Wrap" />
	</Border>

</Window>
