<Application xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="ScreenGrab.App.App"
             RequestedThemeVariant="Default">

	<Application.Styles>
		<FluentTheme />
	</Application.Styles>

	<TrayIcon.Icons>
		<TrayIcons>
			<TrayIcon Icon="/Assets/icon.ico" ToolTipText="ScreenGrab" Clicked="OnTrayClicked">
				<TrayIcon.Menu>
					<NativeMenu>
						<NativeMenuItem Header="Capture" Click="OnCapture" />
						<NativeMenuItemSeparator />
						<NativeMenuItem Header="Run at startup" ToggleType="CheckBox" Click="OnToggleStartup" />
						<NativeMenuItemSeparator />
						<NativeMenuItem Header="Exit" Click="OnExit" />
					</NativeMenu>
				</TrayIcon.Menu>
			</TrayIcon>
		</TrayIcons>
	</TrayIcon.Icons>

</Application>
